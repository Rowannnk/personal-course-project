{
  "name": "personal-course-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "description": "A TypeScript shop loyalty tracker monorepo for the HSFE403 course project.",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:browser": "pnpm --filter @shop/shop-app typecheck:browser",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm typecheck:browser"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "nx": "^24.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
