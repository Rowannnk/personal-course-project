{
  "name": "@shop/shop-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm run build:browser && tsx src/server/index.ts",
    "dev:server": "pnpm run build:browser && tsx watch src/server/index.ts",
    "cli": "tsx src/index.ts",
    "build:browser": "tsc -p tsconfig.browser.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@shop/loyalty-core": "workspace:*",
    "commander": "^15.0.0",
    "fastify": "^5.12.8",
    "inquirer": "^14.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
